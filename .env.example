# Spot API key from https://testnet.binance.vision (or binance.com for live).
# Enable TRADE only. Do not enable withdrawals.
BINANCE_API_KEY=

# HMAC secret. Leave empty when using an Ed25519 key.
BINANCE_API_SECRET=

# Ed25519 PEM private key. This is the faster login: one session.logon,
# then each order skips signing. Binance recommends Ed25519 keys.
# BINANCE_PRIVATE_KEY_PATH=ed25519.pem

# true = testnet. false = real money (CLI still requires --live).
BINANCE_TESTNET=true

# How long Binance may take to accept a signed request, in milliseconds.
BINANCE_RECV_WINDOW=5000
